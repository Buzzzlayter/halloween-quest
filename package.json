{
  "name": "halloween-quest",
  "version": "2.0.0",
  "private": true,
  "description": "Eight illustrated Halloween quests with stable QR links",
  "scripts": {
    "test": "node --test tests/test-game.mjs tests/test-host.mjs tests/test-flow.mjs tests/test-flow-ui.mjs",
    "build": "node scripts/package-site.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cloudflare:login": "wrangler login --device",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
